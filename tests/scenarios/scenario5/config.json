{
  "advanced": {},
  "common": { "name": "Test Hub", "horizon_preset": "3_days" },
  "integration_type": "hub",
  "minor_version": 3,
  "version": 1,
  "participants": {
    "Battery": {
      "name": "Battery",
      "element_type": "battery",
      "connection": { "type": "connection_target", "value": "Inverter" },
      "efficiency": {
        "efficiency_source_target": { "type": "constant", "value": 99.0 },
        "efficiency_target_source": { "type": "constant", "value": 99.0 }
      },
      "limits": {
        "max_charge_percentage": { "type": "constant", "value": 100.0 },
        "min_charge_percentage": { "type": "constant", "value": 10.0 }
      },
      "partitioning": {},
      "power_limits": {
        "max_power_source_target": { "type": "entity", "value": ["sensor.sigen_plant_ess_rated_discharging_power"] },
        "max_power_target_source": { "type": "entity", "value": ["sensor.sigen_plant_ess_rated_charging_power"] }
      },
      "pricing": {
        "price_source_target": { "type": "constant", "value": 0.02 },
        "price_target_source": { "type": "constant", "value": 0.001 },
        "salvage_value": { "type": "constant", "value": 0.0 }
      },
      "storage": {
        "capacity": { "type": "entity", "value": ["sensor.sigen_plant_rated_energy_capacity"] },
        "initial_charge_percentage": { "type": "entity", "value": ["sensor.sigen_plant_battery_state_of_charge"] }
      }
    },
    "Constant Load": {
      "name": "Constant Load",
      "element_type": "load",
      "connection": { "type": "connection_target", "value": "Switchboard" },
      "curtailment": {},
      "forecast": { "forecast": { "type": "constant", "value": 1.0 } },
      "pricing": {}
    },
    "Grid": {
      "name": "Grid",
      "element_type": "grid",
      "connection": { "type": "connection_target", "value": "Switchboard" },
      "power_limits": {
        "max_power_source_target": { "type": "constant", "value": 55.0 },
        "max_power_target_source": { "type": "constant", "value": 30.0 }
      },
      "pricing": {
        "price_source_target": {
          "type": "entity",
          "value": ["sensor.home_general_price", "sensor.home_general_forecast"]
        },
        "price_target_source": {
          "type": "entity",
          "value": ["sensor.home_feed_in_price", "sensor.home_feed_in_forecast"]
        }
      }
    },
    "Inverter": {
      "name": "Inverter",
      "element_type": "inverter",
      "connection": { "type": "connection_target", "value": "Switchboard" },
      "efficiency": {},
      "power_limits": {
        "max_power_source_target": { "type": "entity", "value": ["sensor.sigen_plant_max_active_power"] },
        "max_power_target_source": { "type": "entity", "value": ["sensor.sigen_plant_max_active_power"] }
      }
    },
    "Solar": {
      "name": "Solar",
      "element_type": "solar",
      "connection": { "type": "connection_target", "value": "Inverter" },
      "curtailment": { "curtailment": { "type": "constant", "value": true } },
      "forecast": {
        "forecast": {
          "type": "entity",
          "value": [
            "sensor.solcast_pv_forecast_forecast_day_3",
            "sensor.solcast_pv_forecast_forecast_today",
            "sensor.solcast_pv_forecast_forecast_tomorrow"
          ]
        }
      },
      "pricing": {}
    },
    "Switchboard": { "name": "Switchboard", "element_type": "junction" }
  }
